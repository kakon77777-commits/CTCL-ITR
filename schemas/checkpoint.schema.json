{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/itr/checkpoint-v0.1.json",
  "title": "ITR Checkpoint v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "run_id",
    "event_offset",
    "state_ref",
    "artifact_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "event_offset": {
      "type": "integer",
      "minimum": 0
    },
    "state_ref": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "media_type",
          "role"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
