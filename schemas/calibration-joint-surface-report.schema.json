{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ctcl-itr/calibration-joint-surface-report-v0.2.11.json",
  "title": "CTCL-ITR Calibration Joint Surface Report v0.2.11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "surface_id", "generated_at", "method",
    "base_snapshot_id", "current_snapshot_id", "comparison_id",
    "measurement_contract", "families", "point_reference_family_weights",
    "resampling", "mixture_grid", "conditioning", "subjects",
    "interpretation_boundary", "non_authoritative"
  ],
  "properties": {
    "schema_version": {"const": "0.2.11"},
    "surface_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "method": {"const": "joint_empirical_binomial_simplex_surface_v1"},
    "base_snapshot_id": {"type": "string", "minLength": 1},
    "current_snapshot_id": {"type": "string", "minLength": 1},
    "comparison_id": {"type": "string", "minLength": 1},
    "measurement_contract": {"type": "object"},
    "families": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "point_reference_family_weights": {"$ref": "#/$defs/weights"},
    "resampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed", "replicates", "interval_p", "minimum_supported_fraction"],
      "properties": {
        "method": {"const": "stratified_empirical_binomial_sha256_v1"},
        "seed": {"type": "string", "minLength": 1},
        "replicates": {"type": "integer", "minimum": 1},
        "interval_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimum_supported_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "mixture_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "grid_step", "minimum_family_weight", "max_grid_points", "total_points"],
      "properties": {
        "method": {"const": "simplex_grid_reference_mixture_v1"},
        "grid_step": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "minimum_family_weight": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "max_grid_points": {"type": "integer", "minimum": 1},
        "total_points": {"type": "integer", "minimum": 1}
      }
    },
    "conditioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_counts_resampled", "trial_counts_fixed", "observed_family_weights_fixed",
        "reference_mixture_varied", "mixture_weights_resampled",
        "same_resampled_outcomes_reused_across_mixture_cells", "surface_cells_are_independent"
      ],
      "properties": {
        "outcome_counts_resampled": {"const": true},
        "trial_counts_fixed": {"const": true},
        "observed_family_weights_fixed": {"const": true},
        "reference_mixture_varied": {"const": true},
        "mixture_weights_resampled": {"const": false},
        "same_resampled_outcomes_reused_across_mixture_cells": {"const": true},
        "surface_cells_are_independent": {"const": false}
      }
    },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autonomy", "governance"],
      "properties": {
        "autonomy": {"$ref": "#/$defs/subject"},
        "governance": {"$ref": "#/$defs/subject"}
      }
    },
    "interpretation_boundary": {"const": "joint_sampling_x_reference_mixture_surface"},
    "non_authoritative": {"const": true}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "weights": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "signShares": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative", "zero"],
          "properties": {
            "positive": {"type": "number", "minimum": 0, "maximum": 1},
            "negative": {"type": "number", "minimum": 0, "maximum": 1},
            "zero": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "band": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "median", "upper"],
          "properties": {
            "lower": {"type": "number"},
            "median": {"type": "number"},
            "upper": {"type": "number"}
          }
        }
      ]
    },
    "pointEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_status", "support_reasons", "composition_adjusted_delta", "reference_base_horizon", "reference_current_horizon"],
      "properties": {
        "support_status": {"type": "string", "minLength": 1},
        "support_reasons": {"type": "array", "items": {"type": "string"}},
        "composition_adjusted_delta": {"$ref": "#/$defs/nullableNumber"},
        "reference_base_horizon": {"$ref": "#/$defs/nullableNumber"},
        "reference_current_horizon": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "resampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_replicates", "total_replicates", "supported_fraction",
        "support_status", "band", "mean", "sign_shares", "band_sign_class",
        "unsupported_reason_counts"
      ],
      "properties": {
        "supported_replicates": {"type": "integer", "minimum": 0},
        "total_replicates": {"type": "integer", "minimum": 1},
        "supported_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "support_status": {"enum": ["supported", "insufficient_resampling_support"]},
        "band": {"$ref": "#/$defs/band"},
        "mean": {"$ref": "#/$defs/nullableNumber"},
        "sign_shares": {"$ref": "#/$defs/signShares"},
        "band_sign_class": {"enum": ["positive_band", "negative_band", "crosses_zero", "zero_band", "unsupported"]},
        "unsupported_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_family_weights", "point_estimate", "resampling"],
      "properties": {
        "reference_family_weights": {"$ref": "#/$defs/weights"},
        "point_estimate": {"$ref": "#/$defs/pointEstimate"},
        "resampling": {"$ref": "#/$defs/resampling"}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"$ref": "#/$defs/nullableNumber"},
        "maximum": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "surfaceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cells", "point_supported_cells", "resampling_supported_cells",
        "resampling_supported_fraction", "band_sign_class_counts",
        "sign_sensitive_to_mixture", "support_fraction_range", "band_width_range",
        "unsupported_reason_counts"
      ],
      "properties": {
        "total_cells": {"type": "integer", "minimum": 1},
        "point_supported_cells": {"type": "integer", "minimum": 0},
        "resampling_supported_cells": {"type": "integer", "minimum": 0},
        "resampling_supported_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "band_sign_class_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive_band", "negative_band", "crosses_zero", "zero_band", "unsupported"],
          "properties": {
            "positive_band": {"type": "integer", "minimum": 0},
            "negative_band": {"type": "integer", "minimum": 0},
            "crosses_zero": {"type": "integer", "minimum": 0},
            "zero_band": {"type": "integer", "minimum": 0},
            "unsupported": {"type": "integer", "minimum": 0}
          }
        },
        "sign_sensitive_to_mixture": {"type": "boolean"},
        "support_fraction_range": {"$ref": "#/$defs/range"},
        "band_width_range": {"$ref": "#/$defs/range"},
        "unsupported_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells", "surface_summary"],
      "properties": {
        "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
        "surface_summary": {"$ref": "#/$defs/surfaceSummary"}
      }
    }
  }
}
