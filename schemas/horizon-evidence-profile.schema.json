{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/itr/horizon-evidence-profile-v0.2.7.json",
  "title": "CTCL-ITR HorizonEvidenceProfile v0.2.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calibration_id", "calibrated_at", "measurement_contract", "evidence_confidence_p", "minimums", "subjects", "derived_assessment", "non_authoritative"],
  "$defs": {
    "minimums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_distinct_depths", "min_total_trials", "min_trials_per_depth"],
      "properties": {
        "min_distinct_depths": {"type": "integer", "minimum": 1},
        "min_total_trials": {"type": "integer", "minimum": 1},
        "min_trials_per_depth": {"type": "integer", "minimum": 1}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "trials", "successes", "evidence_refs", "empirical_success_rate", "wilson_lower", "wilson_upper", "fitted_success_rate"],
      "properties": {
        "depth": {"type": "number", "minimum": 0},
        "trials": {"type": "integer", "minimum": 1},
        "successes": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "empirical_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "wilson_lower": {"type": "number", "minimum": 0, "maximum": 1},
        "wilson_upper": {"type": "number", "minimum": 0, "maximum": 1},
        "fitted_success_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "bracket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_depth", "upper_depth", "lower_probability", "upper_probability"],
      "properties": {
        "lower_depth": {"type": "number", "minimum": 0},
        "upper_depth": {"type": "number", "minimum": 0},
        "lower_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "upper_probability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "target_reliability", "evidence_confidence_p", "minimums", "distinct_depths", "total_trials", "total_successes", "support_status", "support_reasons", "horizon_depth", "crossing_bracket", "points", "evidence_refs", "non_authoritative"],
      "properties": {
        "method": {"const": "monotone_binomial_pava_v1"},
        "target_reliability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "evidence_confidence_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "minimums": {"$ref": "#/$defs/minimums"},
        "distinct_depths": {"type": "integer", "minimum": 1},
        "total_trials": {"type": "integer", "minimum": 1},
        "total_successes": {"type": "integer", "minimum": 0},
        "support_status": {"enum": ["supported", "insufficient_evidence", "target_not_bracketed_high", "target_not_bracketed_low"]},
        "support_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "horizon_depth": {"type": ["number", "null"], "minimum": 0},
        "crossing_bracket": {"anyOf": [{"$ref": "#/$defs/bracket"}, {"type": "null"}]},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "non_authoritative": {"const": true}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "assessment_id", "assessed_at", "measurement_contract", "autonomy_horizon_depth", "governance_horizon_depth", "evidence_refs"],
      "properties": {
        "schema_version": {"const": "0.2.6"},
        "assessment_id": {"type": "string", "minLength": 1},
        "assessed_at": {"type": "string", "format": "date-time"},
        "measurement_contract": {"type": "object"},
        "autonomy_horizon_depth": {"type": "number", "minimum": 0},
        "governance_horizon_depth": {"type": "number", "minimum": 0},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "0.2.7"},
    "calibration_id": {"type": "string", "minLength": 1},
    "calibrated_at": {"type": "string", "format": "date-time"},
    "measurement_contract": {"type": "object"},
    "evidence_confidence_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "minimums": {"$ref": "#/$defs/minimums"},
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autonomy", "governance"],
      "properties": {
        "autonomy": {"$ref": "#/$defs/subject"},
        "governance": {"$ref": "#/$defs/subject"}
      }
    },
    "derived_assessment": {"anyOf": [{"$ref": "#/$defs/assessment"}, {"type": "null"}]},
    "non_authoritative": {"const": true}
  }
}
