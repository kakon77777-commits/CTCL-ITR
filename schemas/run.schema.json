{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/itr/run-v0.1.json",
  "title": "ITR Run v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "intent_id",
    "intent_version",
    "plan_id",
    "plan_version",
    "runtime_id",
    "executor_version",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_version": {
      "type": "integer",
      "minimum": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "executor_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "created",
        "resolved",
        "planned",
        "running",
        "suspended",
        "validating",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
