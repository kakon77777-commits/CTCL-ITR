{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/itr/calibration-uncertainty-report-v0.2.9.json",
  "title": "CTCL-ITR CalibrationUncertaintyReport v0.2.9",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "bandValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "median", "upper"],
      "properties": {
        "lower": {"type": "number"},
        "median": {"type": "number"},
        "upper": {"type": "number"}
      }
    },
    "bandSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_replicates", "total_replicates", "supported_fraction", "support_status", "band", "mean"],
      "properties": {
        "supported_replicates": {"type": "integer", "minimum": 0},
        "total_replicates": {"type": "integer", "minimum": 1},
        "supported_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "support_status": {"enum": ["supported", "insufficient_resampling_support"]},
        "band": {"anyOf": [{"$ref": "#/$defs/bandValue"}, {"type": "null"}]},
        "mean": {"type": ["number", "null"]}
      }
    },
    "signShares": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative", "zero"],
          "properties": {
            "positive": {"type": "number", "minimum": 0, "maximum": 1},
            "negative": {"type": "number", "minimum": 0, "maximum": 1},
            "zero": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_estimate", "bands", "family_delta_bands", "sign_shares", "unsupported_reason_counts"],
      "properties": {
        "point_estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_mix_delta", "composition_adjusted_delta", "composition_residual", "composition_total_variation"],
          "properties": {
            "observed_mix_delta": {"type": ["number", "null"]},
            "composition_adjusted_delta": {"type": ["number", "null"]},
            "composition_residual": {"type": ["number", "null"]},
            "composition_total_variation": {"type": ["number", "null"]}
          }
        },
        "bands": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/bandSummary"},
          "required": ["observed_base_horizon", "observed_current_horizon", "observed_mix_delta", "reference_base_horizon", "reference_current_horizon", "composition_adjusted_delta", "composition_residual"]
        },
        "family_delta_bands": {"type": "object", "additionalProperties": {"$ref": "#/$defs/bandSummary"}},
        "sign_shares": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_mix_delta", "composition_adjusted_delta"],
          "properties": {
            "observed_mix_delta": {"$ref": "#/$defs/signShares"},
            "composition_adjusted_delta": {"$ref": "#/$defs/signShares"}
          }
        },
        "unsupported_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    }
  },
  "required": ["schema_version", "uncertainty_id", "generated_at", "method", "seed", "replicates", "interval_p", "minimum_supported_fraction", "base_snapshot_id", "current_snapshot_id", "comparison_id", "measurement_contract", "conditioning", "point_estimate_context", "subjects", "interpretation_boundary", "non_authoritative"],
  "properties": {
    "schema_version": {"const": "0.2.9"},
    "uncertainty_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "method": {"const": "stratified_empirical_binomial_sha256_v1"},
    "seed": {"type": "string", "minLength": 1},
    "replicates": {"type": "integer", "minimum": 1},
    "interval_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "minimum_supported_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "base_snapshot_id": {"type": "string", "minLength": 1},
    "current_snapshot_id": {"type": "string", "minLength": 1},
    "comparison_id": {"type": "string", "minLength": 1},
    "measurement_contract": {"type": "object"},
    "conditioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition_resampled", "observed_family_weights_fixed", "reference_family_weights_fixed", "trial_counts_fixed", "success_counts_resampled"],
      "properties": {
        "composition_resampled": {"const": false},
        "observed_family_weights_fixed": {"const": true},
        "reference_family_weights_fixed": {"const": true},
        "trial_counts_fixed": {"const": true},
        "success_counts_resampled": {"const": true}
      }
    },
    "point_estimate_context": {"type": "object"},
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autonomy", "governance"],
      "properties": {
        "autonomy": {"$ref": "#/$defs/subject"},
        "governance": {"$ref": "#/$defs/subject"}
      }
    },
    "interpretation_boundary": {"const": "conditional_outcome_sampling_uncertainty_only"},
    "non_authoritative": {"const": true}
  }
}
