{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/itr/approval-request-v0.2.3.json",
  "title": "ITR ApprovalRequest v0.2.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "run_id",
    "intent_id",
    "trigger_event_id",
    "requested_action",
    "target",
    "risk_class",
    "reason",
    "options",
    "evidence_refs",
    "authority_requested",
    "requested_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.3"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger_event_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_action": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "max_uses"
      ],
      "properties": {
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "max_uses": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "modified",
        "deferred",
        "cancelled",
        "expired"
      ]
    }
  }
}
