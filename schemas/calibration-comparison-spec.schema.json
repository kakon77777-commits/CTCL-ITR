{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/itr/calibration-comparison-spec-v0.2.8.json",
  "title": "CTCL-ITR CalibrationComparisonSpec v0.2.8",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "generated_at", "reference_family_weights"],
  "properties": {
    "schema_version": {"const": "0.2.8"},
    "comparison_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "reference_family_weights": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    }
  }
}
