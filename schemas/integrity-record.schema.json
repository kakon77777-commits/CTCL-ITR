{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/itr/integrity-record-v0.2.2.json",
  "title": "CTCL-ITR IntegrityRecord v0.2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "ledger_seq", "event_id",
    "hash_algorithm", "record_encoding", "record_digest",
    "previous_chain_digest", "chain_digest"
  ],
  "properties": {
    "schema_version": {"const": "0.2.2"},
    "run_id": {"type": "string", "minLength": 1},
    "ledger_seq": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1},
    "hash_algorithm": {"const": "sha256"},
    "record_encoding": {"const": "atl-jsonl-record-v1"},
    "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previous_chain_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "chain_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
