{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/ctcl-itr/calibration-mixture-sensitivity-spec-v0.2.10.json",
  "title": "CTCL-ITR Calibration Mixture Sensitivity Spec v0.2.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sensitivity_id", "generated_at", "method",
    "grid_step", "minimum_family_weight", "max_grid_points"
  ],
  "properties": {
    "schema_version": {"const": "0.2.10"},
    "sensitivity_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "method": {"const": "simplex_grid_reference_mixture_v1"},
    "grid_step": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "minimum_family_weight": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "max_grid_points": {"type": "integer", "minimum": 1}
  }
}
